{
  "name": "sshman",
  "version": "1.1.0",
  "description": "SSH connection manager - luu, truy cap nhanh va thao tac lenh",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis portable",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win:icon": "electron-builder --win nsis portable --config.win.icon=assets/icon.ico",
    "build:linux:icon": "electron-builder --linux AppImage deb --config.linux.icon=assets/icon.png",
    "lint": "eslint .",
    "test": "npm run lint && node test/platform.test.js && node test/security.test.js && node test/vault.test.js && node test/backup.test.js && node test/import.test.js && node test/sftp.test.js && node test/tunnel.test.js && node test/metrics.test.js && node test/runtime.test.js && node test/utf8.test.js && node test/ssh.test.js && electron test/ui.test.js && electron test/ime.test.js && npm run test:theme",
    "test:runtime": "node test/runtime.test.js",
    "test:platform": "node test/platform.test.js",
    "test:vault": "node test/vault.test.js",
    "test:security": "node test/security.test.js && node test/backup.test.js",
    "test:ssh": "node test/ssh.test.js",
    "test:sftp": "node test/sftp.test.js",
    "test:tunnel": "node test/tunnel.test.js",
    "test:metrics": "node test/metrics.test.js",
    "test:ui": "electron test/ui.test.js",
    "test:import": "node test/import.test.js",
    "test:utf8": "node test/utf8.test.js",
    "test:ime": "electron test/ime.test.js",
    "test:theme": "electron test/theme.test.js dark && electron test/theme.test.js light"
  },
  "author": {
    "name": "Dương Anh Tuấn",
    "email": "anhtuanduongbk@gmail.com"
  },
  "homepage": "https://github.com/nbzezo/teminal_t",
  "license": "MIT",
  "build": {
    "appId": "com.local.sshman",
    "productName": "SSH Manager",
    "asar": true,
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "executableName": "ssh-manager",
      "synopsis": "Trình quản lý kết nối SSH",
      "description": "Lưu và mở các phiên SSH tương tác trên Windows và Ubuntu Desktop"
    }
  },
  "dependencies": {
    "@fontsource/ubuntu-sans": "^5.3.0",
    "@fontsource/ubuntu-sans-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1"
  }
}
